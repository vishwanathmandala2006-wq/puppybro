# Server Configuration
NODE_ENV=production
PORT=3001

# Security - IMPORTANT: Change this to a long random string (min 32 chars)
JWT_SECRET=your-very-long-secret-key-min-32-characters-change-this-in-production

# Database - For Render PostgreSQL (Render will provide this)
DATABASE_URL=postgresql://username:password@host:5432/puppybro

# CORS
CORS_ORIGIN=https://your-domain.render.com